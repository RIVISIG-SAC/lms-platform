generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  INSTRUCTOR
}

enum EnrollmentStatus {
  PENDING
  PAID
  COMPLETED
  FAILED
  EXPIRED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  PENDING_PAYMENT
  EXPIRED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NotificationType {
  // Estudiante
  CERTIFICATE_ISSUED
  PAYMENT_RECEIVED
  ENROLLMENT_CONFIRMED
  ACCESS_EXPIRING
  ACCESS_EXPIRED
  PASSWORD_EXPIRING

  // Admin
  ADMIN_NEW_ENROLLMENT
  ADMIN_NEW_PAYMENT
  ADMIN_CERTIFICATE_ISSUED
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  role                  Role      @default(STUDENT)
  passwordExpiresAt     DateTime
  emailVerified         Boolean   @default(false)
  verificationToken     String?   @unique
  verificationTokenExp  DateTime?
  isActive              Boolean   @default(true)
  dni                   String?
  company               String?
  acceptedTermsAt       DateTime?
  acceptedTermsIp       String?
  acceptedTermsVersion  String?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  passwordResetToken    String?   @unique
  passwordResetTokenExp DateTime?
  tokenVersion          Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  enrollments       Enrollment[]
  instructorProfile InstructorProfile?
  blogPosts         BlogPost[]
  notifications     Notification[]

  @@index([email])
  @@index([verificationToken])
  @@index([passwordResetToken])
}

model InstructorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  avatarUrl      String?
  title          String?
  specialization String?
  linkedin       String?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([userId])
}

model Course {
  id            String       @id @default(cuid())
  title         String
  description   String
  price            Decimal  @db.Decimal(10, 2)
  isFree           Boolean  @default(false)
  certificateFee   Decimal? @db.Decimal(10, 2)
  thumbnailUrl     String?
  category      String?
  level         CourseLevel?
  durationHours               Int?
  certificateValidityDays     Int?
  certificateDescription      String?
  published     Boolean      @default(false)
  instructorId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  instructor  InstructorProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  modules     Module[]
  enrollments Enrollment[]
  questions   Question[]
  certificates Certificate[]
  faqs        CourseFaq[]

  @@index([published])
  @@index([category])
  @@index([level])
  @@index([instructorId])
}

model CourseFaq {
  id        String   @id @default(cuid())
  courseId  String
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

model SystemFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@index([courseId, order])
}

model Chapter {
  id           String   @id @default(cuid())
  moduleId     String
  title        String
  content      String?
  vimeoVideoId String?
  order        Int
  createdAt    DateTime @default(now())

  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  chapterProgress ChapterProgress[]
  resources       ChapterResource[]

  @@index([moduleId, order])
}

model ChapterResource {
  id        String   @id @default(cuid())
  chapterId String
  name      String
  url       String
  type      String   @default("PDF")
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model Enrollment {
  id                 String           @id @default(cuid())
  userId             String
  courseId           String
  status             EnrollmentStatus @default(PENDING)
  progressPercentage Float            @default(0)
  startDate          DateTime         @default(now())
  endDate            DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  course          Course            @relation(fields: [courseId], references: [id])
  examAttempts    ExamAttempt[]
  certificate     Certificate?
  chapterProgress ChapterProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Question {
  id        String   @id @default(cuid())
  courseId  String
  text      String
  order     Int
  createdAt DateTime @default(now())

  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([courseId, order])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ChapterProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  chapterId    String
  completedAt  DateTime   @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapter    Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, chapterId])
  @@index([enrollmentId])
}

model ExamAttempt {
  id            String   @id @default(cuid())
  enrollmentId  String
  score         Float
  passed        Boolean
  attemptNumber Int
  createdAt     DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model Certificate {
  id               String            @id @default(cuid())
  enrollmentId     String?           @unique
  courseId         String?
  issueDate        DateTime          @default(now())
  verificationCode String            @unique @default(cuid())
  status            CertificateStatus @default(ACTIVE)
  certificatePaidAt DateTime?
  expiresAt         DateTime?

  // Snapshot for manual certificates issued to people without a User account
  certificateTitle  String?
  holderName        String?
  holderDni         String?
  holderCompany     String?
  customDescription String?

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([verificationCode])
  @@index([courseId])
}

// ─── Notificaciones ────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
}

// ─── Seguridad ─────────────────────────────────────────────────────────────

// Contador de rate limiting respaldado por la BD. Necesario en serverless:
// un Map en memoria no se comparte entre instancias ni sobrevive a cold starts.
// `key` = `${rateLimitKey}:${identifier}` (p. ej. "auth:login:1.2.3.4").
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ─── Blog ──────────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())

  posts BlogPost[]

  @@index([slug])
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts BlogPostTag[]

  @@index([slug])
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  authorId      String
  categoryId    String?

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

enum CompanyImageSection {
  ABOUT
  GALLERY
}

model Company {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  sector  String?
  logoUrl String?

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  // Hero
  heroTitle     String
  heroHighlight String?
  heroSubtitle  String?
  heroImageUrl  String?

  // ¿Quién es?
  aboutContent String
  fullAddress  String?

  // El reto / Compromiso Alta Dirección / Trabajo en equipo — trío fijo
  challengeText      String?
  challengeImageUrl  String?
  leadershipText     String?
  leadershipImageUrl String?
  teamworkText       String?
  teamworkImageUrl   String?

  // Testimonio (bloque opcional)
  testimonialVimeoId    String?
  testimonialQuote      String?
  testimonialAuthorName String?
  testimonialAuthorRole String?

  // Ficha del Proyecto
  fichaLocation          String?
  fichaClientName        String?
  fichaRuc               String?
  fichaProjectScope      String?
  fichaCertificationYear String?
  fichaProjectStatus     String?
  fichaAccompaniment     String?

  // Cierre / reconocimiento institucional (opcional)
  closingMessage   String?
  closingImageUrl  String?

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facts          CompanyFact[]
  services       CompanyService[]
  achievements   CompanyAchievement[]
  awards         CompanyAward[]
  certifications CompanyCertification[]
  images         CompanyImage[]

  @@index([slug])
  @@index([status, publishedAt])
}

model CompanyFact {
  id        String @id @default(cuid())
  companyId String
  icon      String
  label     String
  value     String?
  order     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyService {
  id          String  @id @default(cuid())
  companyId   String
  title       String
  description String?
  order       Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyAchievement {
  id        String @id @default(cuid())
  companyId String
  text      String
  order     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyAward {
  id          String  @id @default(cuid())
  companyId   String
  title       String
  description String?
  imageUrl    String?
  order       Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyCertification {
  id        String  @id @default(cuid())
  companyId String
  standard  String
  label     String
  icon      String?
  order     Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyImage {
  id        String              @id @default(cuid())
  companyId String
  section   CompanyImageSection
  url       String
  alt       String
  caption   String?
  order     Int                 @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, section, order])
}
