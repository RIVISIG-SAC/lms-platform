generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  INSTRUCTOR
}

enum EnrollmentStatus {
  PENDING
  PAID
  COMPLETED
  FAILED
  EXPIRED
}

/// Cómo se responde una pregunta de la evaluación.
/// `SINGLE` cubre tanto la opción múltiple clásica como verdadero/falso
/// (una sola respuesta válida); `MULTIPLE` exige marcar varias.
enum QuestionType {
  SINGLE
  MULTIPLE
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  PENDING_PAYMENT
  EXPIRED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NotificationType {
  // Estudiante
  CERTIFICATE_ISSUED
  PAYMENT_RECEIVED
  ENROLLMENT_CONFIRMED
  ACCESS_EXPIRING
  ACCESS_EXPIRED
  PASSWORD_EXPIRING

  // Admin
  ADMIN_NEW_ENROLLMENT
  ADMIN_NEW_PAYMENT
  ADMIN_CERTIFICATE_ISSUED
  ADMIN_NEW_SUPPORT_MESSAGE
  ADMIN_NEW_COMPLAINT
}

enum SupportMessageStatus {
  OPEN
  ANSWERED
  CLOSED
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  role                  Role      @default(STUDENT)
  passwordExpiresAt     DateTime
  emailVerified         Boolean   @default(false)
  verificationToken     String?   @unique
  verificationTokenExp  DateTime?
  isActive              Boolean   @default(true)
  dni                   String?
  company               String?
  acceptedTermsAt       DateTime?
  acceptedTermsIp       String?
  acceptedTermsVersion  String?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  passwordResetToken    String?   @unique
  passwordResetTokenExp DateTime?
  tokenVersion          Int       @default(0)
  /// Curso que el visitante eligio antes de registrarse; se consume en el
  /// primer login: si es gratuito lo inscribe, si es de pago lo devuelve al
  /// curso para retomar la compra.
  pendingCourseId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  enrollments       Enrollment[]
  instructorProfile InstructorProfile?
  blogPosts         BlogPost[]
  notifications     Notification[]
  supportMessages   SupportMessage[]
  payments          Payment[]

  @@index([email])
  @@index([verificationToken])
  @@index([passwordResetToken])
}

model InstructorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  avatarUrl      String?
  title          String?
  specialization String?
  linkedin       String?
  website        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([userId])
}

model Course {
  id                      String       @id @default(cuid())
  slug                    String       @unique
  title                   String
  description             String
  price                   Decimal      @db.Decimal(10, 2)
  isFree                  Boolean      @default(false)
  certificateFee          Decimal?     @db.Decimal(10, 2)
  thumbnailUrl            String?
  /// Video de presentación del curso, opcional. Guarda "id" o "id/hash" de
  /// Vimeo (ver lib/vimeo.ts); si está vacío, la ficha cae en la portada.
  previewVimeoId          String?
  category                String?
  level                   CourseLevel?
  durationHours           Int?
  certificateValidityDays Int?
  certificateDescription  String?
  published               Boolean      @default(false)
  instructorId            String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  instructor      InstructorProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  modules         Module[]
  enrollments     Enrollment[]
  questions       Question[]
  certificates    Certificate[]
  faqs            CourseFaq[]
  supportMessages SupportMessage[]
  payments        Payment[]

  @@index([published])
  @@index([category])
  @@index([level])
  @@index([instructorId])
}

model CourseFaq {
  id        String   @id @default(cuid())
  courseId  String
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

model SystemFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime @default(now())

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@index([courseId, order])
}

model Chapter {
  id           String   @id @default(cuid())
  moduleId     String
  title        String
  content      String?
  vimeoVideoId String?
  order        Int
  createdAt    DateTime @default(now())

  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  chapterProgress ChapterProgress[]
  resources       ChapterResource[]

  @@index([moduleId, order])
}

model ChapterResource {
  id        String   @id @default(cuid())
  chapterId String
  name      String
  url       String
  type      String   @default("PDF")
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model Enrollment {
  id                 String           @id @default(cuid())
  userId             String
  courseId           String
  status             EnrollmentStatus @default(PENDING)
  progressPercentage Float            @default(0)
  startDate          DateTime         @default(now())
  endDate            DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  course          Course            @relation(fields: [courseId], references: [id])
  examAttempts    ExamAttempt[]
  certificate     Certificate?
  chapterProgress ChapterProgress[]
  payments        Payment[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Question {
  id        String       @id @default(cuid())
  courseId  String
  text      String
  type      QuestionType @default(SINGLE)
  order     Int
  createdAt DateTime     @default(now())

  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([courseId, order])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ChapterProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  chapterId    String
  completedAt  DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapter    Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, chapterId])
  @@index([enrollmentId])
}

model ExamAttempt {
  id            String   @id @default(cuid())
  enrollmentId  String
  score         Float
  passed        Boolean
  attemptNumber Int
  createdAt     DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model Certificate {
  id                String            @id @default(cuid())
  enrollmentId      String?           @unique
  courseId          String?
  issueDate         DateTime          @default(now())
  verificationCode  String            @unique @default(cuid())
  status            CertificateStatus @default(ACTIVE)
  certificatePaidAt DateTime?
  expiresAt         DateTime?

  // Snapshot for manual certificates issued to people without a User account
  certificateTitle  String?
  holderName        String?
  holderDni         String?
  holderCompany     String?
  customDescription String?

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([verificationCode])
  @@index([courseId])
}

// ─── Pagos ─────────────────────────────────────────────────────────────────

enum PaymentKind {
  COURSE
  CERTIFICATE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Cada intento de cobro con Culqi. Se crea en PENDING antes de llamar a la
/// API para que ningún cobro quede sin rastro, y es la base para conciliar y
/// aplicar la política de reembolsos.
model Payment {
  id             String        @id @default(cuid())
  userId         String
  kind           PaymentKind
  courseId       String
  /// Para CERTIFICATE se conoce desde el inicio; para COURSE se completa al
  /// otorgar el acceso.
  enrollmentId   String?
  /// Monto cobrado, calculado en el servidor desde el precio de la BD.
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("PEN")
  status         PaymentStatus @default(PENDING)
  culqiChargeId  String?       @unique
  failureMessage String?
  paidAt         DateTime?
  /// Momento en que se entregó lo comprado (acceso o certificado). Hace
  /// idempotente la entrega entre la ruta de pago y el webhook.
  fulfilledAt    DateTime?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

// ─── Notificaciones ────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
}

// ─── Seguridad ─────────────────────────────────────────────────────────────

// Contador de rate limiting respaldado por la BD. Necesario en serverless:
// un Map en memoria no se comparte entre instancias ni sobrevive a cold starts.
// `key` = `${rateLimitKey}:${identifier}` (p. ej. "auth:login:1.2.3.4").
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ─── Blog ──────────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  posts BlogPost[]

  @@index([slug])
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts BlogPostTag[]

  @@index([slug])
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  authorId      String
  categoryId    String?

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

enum CompanyImageSection {
  ABOUT
  GALLERY
}

model Company {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  sector  String?
  logoUrl String?

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  // Hero
  heroTitle     String
  heroHighlight String?
  heroSubtitle  String?
  heroImageUrl  String?

  // ¿Quién es?
  aboutContent String
  fullAddress  String?

  // El reto / Compromiso Alta Dirección / Trabajo en equipo — trío fijo
  challengeText      String?
  challengeImageUrl  String?
  leadershipText     String?
  leadershipImageUrl String?
  teamworkText       String?
  teamworkImageUrl   String?

  // Testimonio (bloque opcional)
  testimonialVimeoId    String?
  testimonialQuote      String?
  testimonialAuthorName String?
  testimonialAuthorRole String?

  // Ficha del Proyecto
  fichaLocation          String?
  fichaClientName        String?
  fichaRuc               String?
  fichaProjectScope      String?
  fichaCertificationYear String?
  fichaProjectStatus     String?
  fichaAccompaniment     String?

  // Cierre / reconocimiento institucional (opcional)
  closingMessage  String?
  closingImageUrl String?

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facts          CompanyFact[]
  services       CompanyService[]
  achievements   CompanyAchievement[]
  awards         CompanyAward[]
  certifications CompanyCertification[]
  images         CompanyImage[]

  @@index([slug])
  @@index([status, publishedAt])
}

model CompanyFact {
  id        String  @id @default(cuid())
  companyId String
  icon      String
  label     String
  value     String?
  order     Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyService {
  id          String  @id @default(cuid())
  companyId   String
  title       String
  description String?
  order       Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyAchievement {
  id        String @id @default(cuid())
  companyId String
  text      String
  order     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyAward {
  id          String  @id @default(cuid())
  companyId   String
  title       String
  description String?
  imageUrl    String?
  order       Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyCertification {
  id        String  @id @default(cuid())
  companyId String
  standard  String
  label     String
  icon      String?
  order     Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, order])
}

model CompanyImage {
  id        String              @id @default(cuid())
  companyId String
  section   CompanyImageSection
  url       String
  alt       String
  caption   String?
  order     Int                 @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, section, order])
}

/// Consulta enviada por un estudiante desde "Contactar tutor".
///
/// Se guarda en BD además de enviarse por correo: el correo puede fallar o
/// perderse en un buzón compartido, y el mensaje de un alumno no debe
/// depender de eso para existir.
model SupportMessage {
  id      String  @id @default(cuid())
  /// Nulo si la cuenta se elimina: el mensaje sobrevive al usuario.
  userId  String?
  /// Copia del remitente al momento de escribir, por si cambia su perfil.
  name    String
  email   String
  subject String
  message String

  /// Curso desde el que se escribió, si la consulta salió de uno.
  courseId    String?
  /// Copia del título: el curso puede renombrarse o borrarse después.
  courseTitle String?

  status     SupportMessageStatus @default(OPEN)
  /// Si el correo de aviso salió o no; el mensaje queda guardado igual.
  emailSent  Boolean              @default(false)
  emailError String?
  answeredAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([courseId])
  @@index([createdAt])
}

enum ComplaintType {
  /// Disconformidad con el producto o servicio contratado.
  RECLAMO
  /// Malestar por la atención, no relacionado con el producto o servicio.
  QUEJA
}

enum ComplaintStatus {
  PENDING
  ANSWERED
}

enum ComplaintDocumentType {
  DNI
  CE
  PASAPORTE
  RUC
}

/// Hoja de reclamación del Libro de Reclamaciones virtual (D.S. 011-2011-PCM).
///
/// Es un registro legal: no se borra ni se edita lo que escribió el consumidor.
/// Solo se añade la respuesta del proveedor. INDECOPI exige conservarlas al
/// menos dos años, así que no cuelga de `User` ni de `Course`: si se elimina
/// la cuenta o el curso, la hoja sigue intacta.
model Complaint {
  id     String @id @default(cuid())
  /// Correlativo de la hoja; el código visible es `LR-<año>-<número>`.
  number Int    @unique @default(autoincrement())

  // Consumidor
  consumerName   String
  documentType   ComplaintDocumentType
  documentNumber String
  address        String
  phone          String
  email          String
  isMinor        Boolean               @default(false)
  /// Padre, madre o apoderado; obligatorio si el consumidor es menor de edad.
  guardianName   String?

  // Bien contratado
  itemType        String
  amount          Decimal? @db.Decimal(10, 2)
  itemDescription String

  // Detalle
  type    ComplaintType
  detail  String
  request String

  // Respuesta del proveedor
  status        ComplaintStatus @default(PENDING)
  response      String?
  respondedAt   DateTime?
  respondedById String?

  /// Si la constancia llegó al correo del consumidor; la hoja existe igual.
  receiptEmailSent  Boolean @default(false)
  responseEmailSent Boolean @default(false)
  emailError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}
