# Neon — https://console.neon.tech → Connection Details
# "Pooled connection" (Session mode) para runtime:
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/lms_platform?sslmode=require"
# "Direct connection" para migraciones (prisma migrate):
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/lms_platform?sslmode=require"
JWT_SECRET="cambia-esto-por-una-clave-segura-de-32-caracteres-minimo"

# Culqi — https://culqi.com/panel/desarrolladores
CULQI_PUBLIC_KEY="pk_test_..."
CULQI_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CULQI_PUBLIC_KEY="pk_test_..."

# Cloudinary — https://cloudinary.com/console → Settings → API Keys
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu_cloud_name"

# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_..."

# URL pública de la app (Vercel domain o custom domain)
NEXT_PUBLIC_APP_URL="https://tu-app.vercel.app"

# WhatsApp — botón burbuja en páginas públicas (sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER="51965772053"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Hola, me gustaría obtener más información sobre sus cursos y servicios."
